# Private production configuration. Copy to keycloak.env, fill values, then chmod 600.
# Do not commit keycloak.env.

POSTGRES_DB=yca_keycloak
POSTGRES_USER=yca_keycloak
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE

KC_DB=postgres
KC_DB_URL_HOST=keycloak-db
KC_DB_URL_DATABASE=yca_keycloak
KC_DB_USERNAME=yca_keycloak
KC_DB_PASSWORD=REPLACE_WITH_THE_SAME_POSTGRES_PASSWORD
KC_BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_A_NON_DEFAULT_ADMIN_USERNAME
KC_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
KC_HOSTNAME=https://auth.silvadigitaltech.com
KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=false
