# MCP/backend runtime. Copy values into your hosting platform's environment.
# Never commit a populated secret file.

# ---- Product/publication identity ----
YCA_APP_NAME=YouTube Creator Agent
YCA_APP_DESCRIPTION=Analisa dados reais do YouTube, valida oportunidades e aplica alterações aprovadas no canal.
YCA_APP_PUBLIC_URL=
YCA_PRIVACY_URL=
YCA_TERMS_URL=
YCA_SUPPORT_URL=

# ---- Security secrets ----
# Required for write-operation approvals. Use a random value with 24+ characters.
YCA_APPROVAL_SECRET=

# Required for cloud/multi-tenant secret encryption.
# Generate a Fernet key externally and store only in your hosting secret manager.
YCA_DATA_ENCRYPTION_KEY=

# ---- Google / YouTube OAuth ----
# Web application used to connect each customer's own YouTube channel.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ---- OAuth/OIDC for ChatGPT/MCP app users ----
# Services are resource servers: they validate bearer tokens but do not issue them.
YCA_AUTH_ISSUER_URL=
YCA_MCP_PUBLIC_URL=
YCA_AUTH_INTROSPECTION_URL=
YCA_AUTH_INTROSPECTION_CLIENT_ID=
YCA_AUTH_INTROSPECTION_CLIENT_SECRET=

# ---- Public onboarding ----
# Public HTTPS origin, e.g. https://creator.example.com
# ChatGPT creates short-lived one-time links under this origin. No tenant_id is embedded.
YCA_ONBOARDING_PUBLIC_URL=

# ---- MCP runtime ----
YCA_MCP_HOST=127.0.0.1
YCA_MCP_PORT=8000

# ---- Onboarding HTTP runtime ----
YCA_ONBOARDING_HOST=127.0.0.1
YCA_ONBOARDING_PORT=8080
YCA_ONBOARDING_SUCCESS_URL=
YCA_ENABLE_API_DOCS=0
YCA_FORWARDED_ALLOW_IPS=127.0.0.1
# Keep enabled in production. Set 0 only for local HTTP development.
YCA_SECURE_COOKIES=1

# ---- Logging ----
YCA_LOG_LEVEL=INFO

# ---- Shared data/runtime paths ----
YCA_ROOT=
YCA_TENANT_DB=
